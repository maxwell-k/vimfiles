#!/usr/bin/env vader
" pack/vendored/opt/brackets/test/index.vader
" Copyright 2026 Keith Maxwell
" SPDX-License-Identifier: MPL-2.0
"
Given markdown (Three words):
  One two three
Execute (Use the mapping):
  packadd brackets
  execute "normal \<Plug>BracketAddiw"
Expect todo (Three words with one bracketed):
  ⌜One⌟ two three

Given markdown (Three words):
  One two three
Execute (WORD forward then use the mapping):
  packadd brackets
  execute "normal W\<Plug>BracketAddiw"
Expect todo (Three words with one bracketed):
  One ⌜two⌟ three

Given markdown (Three words):
  One two three
Execute (2 WORDs forward then use the mapping):
  packadd brackets
  execute "normal WW\<Plug>BracketAddiw"
Expect todo (Three words with one bracketed):
  One two ⌜three⌟

Given markdown (Three words over two lines):
  One
  two three
Execute (Use the mapping on 2 WORDs):
  packadd brackets
  execute "normal \<Plug>BracketAdd2e"
Expect todo (Three words with two bracketed):
  ⌜One
  two⌟ three
